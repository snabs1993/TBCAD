# ctest helper: `tbcad --list-commands F` writes a Markdown table that names real commands.
set(ENV{TBCAD_CONFIG_DIR} "${CONFIG}")
set(ENV{TBCAD_DATA_DIR} "${CONFIG}/data")
file(REMOVE "${OUT}")
execute_process(COMMAND "${EXE}" --list-commands "${OUT}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "tbcad --list-commands exited with ${rc}")
endif()
file(READ "${OUT}" table)
foreach(needle "| Command | Aliases | What it does |" "| UNDO |" "| ZOOM |")
  string(FIND "${table}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "command list lacks '${needle}':\n${table}")
  endif()
endforeach()
