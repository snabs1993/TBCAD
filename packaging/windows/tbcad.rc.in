// Version and icon resource of tbcad.exe, configured by apps/tbcad/CMakeLists.txt.
#include <winver.h>

1 ICON "@TBCAD_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @TBCAD_VERSION_COMMAS@
 PRODUCTVERSION @TBCAD_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TBCAD contributors"
            VALUE "FileDescription", "TBCAD - free 2D CAD"
            VALUE "FileVersion", "@TBCAD_VERSION_DOTS@"
            VALUE "InternalName", "tbcad"
            VALUE "LegalCopyright", "Copyright (c) TBCAD contributors. MIT License."
            VALUE "OriginalFilename", "tbcad.exe"
            VALUE "ProductName", "TBCAD"
            VALUE "ProductVersion", "@TBCAD_VERSION_DOTS@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
