# Command module registration (owned by the command framework, libs/cmd).
#
# Every command module lives in libs/commands/<m>/ and has a CMakeLists.txt (the library, built
# with tbcad_add_library) plus a module.cmake that declares how the module registers itself:
#
#   tbcad_command_module(NAME draw
#                        REGISTER tbcad::draw::registerCommands         # void(tbcad::cmd::Registry&)
#                        [UI_REGISTER tbcad::draw::registerUi]          # void(tbcad::ui::UiRegistry&)
#                        [TARGET tbcad_draw])                           # default: tbcad_<NAME>
#
# libs/cmd/CMakeLists.txt calls tbcad_discover_command_modules(), which includes every
# libs/commands/*/module.cmake and, once the whole tree is configured, generates
#
#   <build>/generated/cmd/register_all.cpp
#   <build>/generated/cmd/include/tbcad/cmd/register_all.h
#       void tbcad::registerAllCommands(tbcad::cmd::Registry&);   // built-ins + every module
#       void tbcad::registerAllUi(tbcad::ui::UiRegistry&);        // every module's UI hook
#
# and a static library `tbcad_command_registry` (alias tbcad::command_registry) that contains the
# generated file and links tbcad::cmd plus every module. The application links that target.
#
# Nobody edits a central list: adding a module folder is enough.

option(TBCAD_REGISTER_EXAMPLE_COMMANDS
       "Register the demo commands from libs/commands/_example (the template module)" ON)
# Type the generated registerAllUi forwards to. Owned by libs/ui; change if that moves.
set(TBCAD_UI_REGISTRY_TYPE "tbcad::ui::UiRegistry" CACHE STRING
    "Fully qualified C++ name of the UI registry class")

function(tbcad_command_module)
  cmake_parse_arguments(ARG "EXAMPLE" "NAME;REGISTER;UI_REGISTER;TARGET" "" ${ARGN})
  if(NOT ARG_NAME OR NOT ARG_REGISTER)
    message(FATAL_ERROR "tbcad_command_module needs NAME and REGISTER")
  endif()
  foreach(_fn IN ITEMS "${ARG_REGISTER}" "${ARG_UI_REGISTER}")
    if(_fn AND NOT _fn MATCHES "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+$")
      message(FATAL_ERROR "tbcad_command_module(${ARG_NAME}): '${_fn}' must be a qualified "
                          "function name such as tbcad::${ARG_NAME}::registerCommands")
    endif()
  endforeach()
  if(NOT ARG_TARGET)
    set(ARG_TARGET "tbcad_${ARG_NAME}")
  endif()
  get_property(_known GLOBAL PROPERTY TBCAD_COMMAND_MODULES)
  if(ARG_NAME IN_LIST _known)
    message(FATAL_ERROR "command module '${ARG_NAME}' is declared twice")
  endif()
  if(ARG_EXAMPLE AND NOT TBCAD_REGISTER_EXAMPLE_COMMANDS)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY TBCAD_COMMAND_MODULES "${ARG_NAME}")
  set_property(GLOBAL PROPERTY TBCAD_CMDMOD_${ARG_NAME}_TARGET "${ARG_TARGET}")
  set_property(GLOBAL PROPERTY TBCAD_CMDMOD_${ARG_NAME}_REGISTER "${ARG_REGISTER}")
  set_property(GLOBAL PROPERTY TBCAD_CMDMOD_${ARG_NAME}_UI "${ARG_UI_REGISTER}")
endfunction()

# "a::b::fn" -> namespace "a::b", function "fn"
function(_tbcad_split_qualified qualified out_ns out_fn)
  string(REGEX REPLACE "::[^:]+$" "" _ns "${qualified}")
  string(REGEX REPLACE "^.*::" "" _fn "${qualified}")
  set(${out_ns} "${_ns}" PARENT_SCOPE)
  set(${out_fn} "${_fn}" PARENT_SCOPE)
endfunction()

function(_tbcad_generate_command_registry)
  get_property(_mods GLOBAL PROPERTY TBCAD_COMMAND_MODULES)
  list(SORT _mods)

  set(_decl_cmd "")
  set(_call_cmd "")
  set(_decl_ui "")
  set(_call_ui "")
  set(_links "")
  foreach(_m IN LISTS _mods)
    get_property(_target GLOBAL PROPERTY TBCAD_CMDMOD_${_m}_TARGET)
    get_property(_reg GLOBAL PROPERTY TBCAD_CMDMOD_${_m}_REGISTER)
    get_property(_ui GLOBAL PROPERTY TBCAD_CMDMOD_${_m}_UI)
    if(NOT TARGET ${_target})
      message(FATAL_ERROR "command module '${_m}' declares target '${_target}', "
                          "but no such target exists (check its CMakeLists.txt)")
    endif()
    list(APPEND _links ${_target})
    _tbcad_split_qualified("${_reg}" _ns _fn)
    string(APPEND _decl_cmd "namespace ${_ns} { void ${_fn}(tbcad::cmd::Registry&); }\n")
    string(APPEND _call_cmd "    ${_reg}(registry);\n")
    if(_ui)
      _tbcad_split_qualified("${_ui}" _uns _ufn)
      string(APPEND _decl_ui "namespace ${_uns} { void ${_ufn}(${TBCAD_UI_REGISTRY_TYPE}&); }\n")
      string(APPEND _call_ui "    ${_ui}(registry);\n")
    endif()
  endforeach()

  _tbcad_split_qualified("${TBCAD_UI_REGISTRY_TYPE}" _ui_ns _ui_cls)

  set(_gen "${CMAKE_BINARY_DIR}/generated/cmd")
  set(_hdr "${_gen}/include/tbcad/cmd/register_all.h")
  set(_src "${_gen}/register_all.cpp")

  set(_hdr_text
"// Generated by cmake/command_modules.cmake. Do not edit.
#pragma once

namespace tbcad::cmd { class Registry; }
namespace ${_ui_ns} { class ${_ui_cls}; }

namespace tbcad {

// Framework built-ins (UNDO, REDO, ALIASES ...) plus every command module.
void registerAllCommands(cmd::Registry& registry);
// Every module's UI hook (panels, menu items ...).
void registerAllUi(${TBCAD_UI_REGISTRY_TYPE}& registry);

}  // namespace tbcad
")
  set(_src_text
"// Generated by cmake/command_modules.cmake. Do not edit.
#include \"tbcad/cmd/register_all.h\"

#include \"tbcad/cmd/registry.h\"

${_decl_cmd}${_decl_ui}
namespace tbcad {

void registerAllCommands(cmd::Registry& registry) {
    cmd::registerBuiltinCommands(registry);
${_call_cmd}}

void registerAllUi([[maybe_unused]] ${TBCAD_UI_REGISTRY_TYPE}& registry) {
${_call_ui}}

}  // namespace tbcad
")
  # Only rewrite when the content changed, so builds stay incremental.
  foreach(_pair IN ITEMS "${_hdr}|${_hdr_text}" "${_src}|${_src_text}")
    string(FIND "${_pair}" "|" _bar)
    string(SUBSTRING "${_pair}" 0 ${_bar} _file)
    math(EXPR _from "${_bar} + 1")
    string(SUBSTRING "${_pair}" ${_from} -1 _text)
    set(_old "")
    if(EXISTS "${_file}")
      file(READ "${_file}" _old)
    endif()
    if(NOT _old STREQUAL _text)
      file(WRITE "${_file}" "${_text}")
    endif()
  endforeach()

  add_library(tbcad_command_registry STATIC "${_src}")
  target_include_directories(tbcad_command_registry PUBLIC "${_gen}/include")
  target_compile_features(tbcad_command_registry PUBLIC cxx_std_20)
  target_link_libraries(tbcad_command_registry PUBLIC tbcad::cmd ${_links})
  tbcad_set_warnings(tbcad_command_registry)
  add_library(tbcad::command_registry ALIAS tbcad_command_registry)
endfunction()

# Includes every libs/commands/*/module.cmake and schedules the generation for the end of the
# top-level configure step (all module targets exist by then). Call once, from libs/cmd.
function(tbcad_discover_command_modules)
  get_property(_done GLOBAL PROPERTY TBCAD_COMMAND_MODULES_DISCOVERED)
  if(_done)
    return()
  endif()
  set_property(GLOBAL PROPERTY TBCAD_COMMAND_MODULES_DISCOVERED TRUE)
  file(GLOB _files CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/libs/commands/*/module.cmake")
  list(SORT _files)
  foreach(_f IN LISTS _files)
    include("${_f}")
  endforeach()
  cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL _tbcad_generate_command_registry)
endfunction()
