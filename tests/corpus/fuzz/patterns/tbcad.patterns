# TBCAD hatch patterns. Written from scratch for TBCAD; MIT licensed like the rest of the project.
#
# Format (one pattern per [NAME] section):
#   description = free text
#   solid       = yes            (a pattern with no lines: a solid fill)
#   line        = angle | origin x,y | delta dx,dy | dash list
#
# All lengths are millimetres at pattern scale 1, angles are degrees counter-clockwise from +X.
# One `line` is a family of parallel lines: the first passes through `origin`; every next line is
# shifted by `dx` along the line and `dy` perpendicular to it (to the left of the direction).
# The dash list alternates drawn and skipped lengths: a positive number is a dash, a negative
# number a gap, 0 a dot. An empty list is a continuous line. The dash cycle starts at the point
# where each line crosses its own origin position (origin + k*delta).

[SOLID]
description = Solid fill
solid = yes

[LINE45]
description = Diagonal lines at 45 degrees
line = 45 | 0,0 | 0,3 |

[LINE0]
description = Horizontal lines
line = 0 | 0,0 | 0,3 |

[CROSS45]
description = Diagonal crosshatch
line = 45 | 0,0 | 0,3 |
line = 135 | 0,0 | 0,3 |

[GRID]
description = Square grid
line = 0 | 0,0 | 0,6 |
line = 90 | 0,0 | 0,6 |

[BRICK]
description = Running-bond brickwork, brick 12 x 6
line = 0 | 0,0 | 0,6 |
line = 90 | 0,0 | 0,12 | 6,-6
line = 90 | 6,6 | 0,12 | 6,-6

[DOTS]
description = Regular dots
line = 0 | 0,0 | 0,4 | 0,-4

